# ==============================================================================
# Production Environment Configuration Template — CodeCrew
# Copy to .env in production on the server: cp .env.prod.example .env
# ==============================================================================

# Core & Flask Runtime
FLASK_ENV=production
SECRET_KEY=change-to-a-strong-random-hex-key
WTF_CSRF_SECRET_KEY=change-to-another-strong-random-hex-key
TRUSTED_PROXY_COUNT=1
APP_BASE_URL=https://codecrew.abhishekpathak.site
SERVER_NAME=codecrew.abhishekpathak.site
PREFERRED_URL_SCHEME=https

# Database Configuration (PostgreSQL 16)
POSTGRES_DB=codecrews
POSTGRES_USER=codecrews
POSTGRES_PASSWORD=your-secure-postgres-password
DATABASE_URL=postgresql://codecrews:your-secure-postgres-password@db:5432/codecrews

# Mail Service & Notification Routing
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@codecrew.abhishekpathak.site
MAIL_SUPPRESS_SEND=False
ADMIN_NOTIFICATION_EMAIL=abhishekpathak4312@gmail.com

# File Upload Policies
UPLOAD_FOLDER=app/static/uploads
PRIVATE_UPLOAD_FOLDER=instance/private_uploads
MAX_CONTENT_LENGTH=26214400

# Session & Security Hardening
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
CODER_SESSION_HOURS=8

# Token Lifetimes (Seconds)
RESET_TOKEN_MAX_AGE=3600
INVITE_TOKEN_MAX_AGE=259200
APPLICATION_VERIFY_MAX_AGE=604800
INTERESTED_TOKEN_MAX_AGE=2592000

# Initial Admin & Coder Credentials for Production Seeding
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=your-admin-password
CODER_SEED_USERNAME=coder
CODER_SEED_PASSWORD=your-coder-password
CODER_SEED_EMAIL=coder@codecrew.abhishekpathak.site
