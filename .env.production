# Core & Flask Runtime
FLASK_ENV=production
SECRET_KEY=67fc08917f063da4eabb84d1ba653af3161c72c6858215d665be1bdd0c9027b0
WTF_CSRF_SECRET_KEY=f873b64e95f692a752dbc74f30097fb4d423211414d79897f27ff076a3050259
TRUSTED_PROXY_COUNT=1
APP_BASE_URL=https://codecrew.abhishekpathak.site
SERVER_NAME=codecrew.abhishekpathak.site
PREFERRED_URL_SCHEME=https

# Database Configuration (Dockerized PostgreSQL 16)
POSTGRES_DB=codecrews
POSTGRES_USER=codecrews
POSTGRES_PASSWORD=codecrews_secret_2026
