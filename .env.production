# Mail Service & Notification Routing
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=abhishekpathak4312@gmail.com
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@codecrew.abhishekpathak.site
MAIL_SUPPRESS_SEND=False
ADMIN_NOTIFICATION_EMAIL=abhishekpathak4312@gmail.com

# File Upload Policies (5 MB Max Upload Limit)
UPLOAD_FOLDER=app/static/uploads
PRIVATE_UPLOAD_FOLDER=instance/private_uploads
MAX_CONTENT_LENGTH=26214400

# Session & Security Hardening
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
CODER_SESSION_HOURS=8

# Token Lifetimes (Seconds)
RESET_TOKEN_MAX_AGE=3600
INVITE_TOKEN_MAX_AGE=259200
APPLICATION_VERIFY_MAX_AGE=604800
INTERESTED_TOKEN_MAX_AGE=2592000

# Coder Applications & Domain Alert Queues
ALERT_BATCH_SIZE=100
UNVERIFIED_APPLICATION_TTL_DAYS=30

# Initial Admin & Coder Credentials for Production Seeding
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=CodeCrew@Production2026!
CODER_SEED_USERNAME=coder
CODER_SEED_PASSWORD=CoderSquad@2026!
